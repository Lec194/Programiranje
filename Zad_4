#include <iostream>
using namespace std;

bool ispravanUnos(int b, int m) {
    return m > 0 && b >= 0 && b <= m;
}
double izracunajPostotak(int b, int m) {
    return 100.0 * b / m;
}
int odrediOcjenu(double p) {
    if (p < 50) return 1;
    if (p < 65) return 2;
    if (p < 80) return 3;
    if (p < 90) return 4;
    return 5;
}

void ispisiIzvjestaj(int b, int m, double p, int o) {
    cout << "Bodovi: " << b << "/" << m << "\nPostotak: " << p << "%\nOcjena: " << o << endl;
}

int main() {
    int b, m;
    cout << "Unesi bodove i maksimalan broj bodova: ";
    cin >> b >> m;

    if (!ispravanUnos(b, m)) {
        cout << "Greska: Neispravan unos!" << endl;
        return 0;
    }

    double p = izracunajPostotak(b, m);
    ispisiIzvjestaj(b, m, p, odrediOcjenu(p));

    return 0;
}

#include <iostream>
#include <cmath>
#include <cstdio>

using namespace std;

int main()
{
    double x1, x2, y1, y2;

    cout << "Unesi x1 i x2: " << endl;
    cin >> x1 >> x2; 

    cout << "Unesi y1 i y2: " << endl;
    cin >> y1 >> y2; 

 
    double d = sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)); 
    
    cout << "Udaljenost je: " << d << endl;

    return 0;
}

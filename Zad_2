#include <iostream>
#include <cmath>
using namespace std;

bool jeParan(int b) {
    return b % 2 == 0;
}

int apsolutnaVrijednost(int b) {
    return abs(b);
}

int kvadrat(int b) {
    return b * b;
}

void ispisiAnalizu(int b) {
    if (jeParan(b)) {
        cout << "Broj je paran." << endl;
    } else {
        cout << "Broj je neparan." << endl;
    }
    cout << "Apsolutna vrijednost: " << apsolutnaVrijednost(b) << endl;
    cout << "Kvadrat broja: " << kvadrat(b) << endl;
}

int main() {
    int b;
    do {
        cout << "Unesi cijeli broj (-100 do 100): ";
        cin >> b;
    } while (b < -100 || b > 100);

    ispisiAnalizu(b);
    return 0;
}
